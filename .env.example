# Copy this to .env in the same directory and fill in real values. docker compose loads .env from the
# directory it runs in. Nothing in the DAGs, dbt or docker-compose.yml has a default value: a missing
# setting stops `docker compose up` (secrets below) or the task that needs it, with an error naming it.

AIRFLOW_UID=50000

# --- Container secrets (used by docker-compose.yml) ---
# Airflow metadata database. Used inside a connection URL, so letters, digits, '-' or '_' only.
AIRFLOW_DB_PASSWORD=
# Password for the Airflow 'admin' user (used when airflow-init first creates it).
AIRFLOW_ADMIN_PASSWORD=
# Marquez database (also read by marquez.yml).
MARQUEZ_DB_PASSWORD=

# --- Staging Postgres (DAGs 01/03/04 and dbt's profiles.yml) ---
STAGING_DB_HOST=
STAGING_DB_PORT=
STAGING_DB_NAME=
STAGING_DB_USER=
STAGING_DB_PASSWORD=

# --- Synthea generation (DAG 01) ---
# Folder inside the container holding synthea-with-dependencies*.jar; bundles go to <SYNTHEA_DIR>/fhir.
SYNTHEA_DIR=
# Patients per run.
SYNTHEA_PATIENTS=

# --- dbt and lineage (DAG 02) ---
DBT_PROJECT_DIR=
DBT_VENV_DIR=
MARQUEZ_URL=

# --- Snowflake push via Snowpipe (DAG 03), key-pair auth ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_TARGET_DB=
SNOWFLAKE_TARGET_SCHEMA=
# Path to the private key INSIDE the container.
SNOWFLAKE_DOCKER_PRIVATE_KEY_PATH=
# Optional: full Snowflake host, if it is not <account>.snowflakecomputing.com.
# SNOWFLAKE_HOST=
