# Copy this to .env in the same directory (airflow_stack/) and fill in real values.
# docker compose automatically loads .env from the directory it's run in.

AIRFLOW_UID=50000

POSTGRES_PASSWORD=

SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_ROLE=
SNOWFLAKE_WH=
SNOWFLAKE_DB=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_PRIVATE_KEY_PATH=/home/airflow/.snowflake/rsa_key.p8
